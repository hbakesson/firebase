// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Project Tracker Models ──────────────────────────────────────────────────

model Organization {
  id                   String   @id @default(cuid())
  name                 String
  fiscalYearStartMonth Int      @default(1)
  defaultCurrency      String   @default("USD")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users     User[]
  projects  Project[]
  teams     Team[]
  roles     Role[]
  periods   Period[]
  auditLogs AuditLog[]
}

model Team {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  code           String        @unique
  parentTeamId   String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  parentTeam     Team?         @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams     Team[]        @relation("TeamHierarchy")
  projects       Project[]
  allocations    Allocation[]
}

model Role {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  baseRate       Float         @default(0)
  
  organization   Organization  @relation(fields: [organizationId], references: [id])
  allocations    Allocation[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Project {
  id             String        @id @default(cuid())
  organizationId String?
  teams          Team[]
  name           String        @unique
  code           String        @unique @default(cuid())
  description    String?
  status         String        @default("PLANNED") // PLANNED | ACTIVE | COMPLETED | ARCHIVED
  priority       Int           @default(1)
  progress       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  createdBy      String

  organization   Organization? @relation(fields: [organizationId], references: [id])
  logs           AuditLog[]
  allocations    Allocation[]
}

model Period {
  id             String        @id @default(cuid())
  organizationId String
  type           String        // MONTH | QUARTER | WEEK
  startDate      DateTime
  endDate        DateTime
  label          String
  isLocked       Boolean       @default(false)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  allocations    Allocation[]

  @@unique([organizationId, type, startDate, endDate])
}

// ─── Resource & Capacity Core ────────────────────────────────────────────────

model Allocation {
  id             String   @id @default(cuid())
  projectId      String
  teamId         String
  userId         String?  // Linked to a specific resource
  roleId         String?  // Linked to a placeholder role (Scoro)
  periodId       String
  date           DateTime? 

  type           String   @default("WORK") // WORK | PIPELINE | TIME_OFF
  
  requestedHours Float    @default(0)
  allocatedHours Float    @default(0)
  actualHours    Float    @default(0)
  
  updatedAt      DateTime @updatedAt

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role           Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  period         Period   @relation(fields: [periodId], references: [id])

  @@unique([projectId, teamId, userId, roleId, periodId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  action         String        // CREATE | UPDATE | DELETE
  entityType     String        @default("Project") // Project | Team | Budget
  entityId       String?
  projectName    String
  previousValue  String?
  newValue       String?
  userId         String
  userEmail      String
  timestamp      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id])
  project        Project?      @relation(fields: [entityId], references: [id], onDelete: SetNull)
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  organizationId String?
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  isGuest        Boolean       @default(false)
  isPlaceholder  Boolean       @default(false) // Scoro placeholder resource
  role           String        @default("user")
  
  // Capacity planning
  capacityPerDay Float         @default(8.0)
  
  organization   Organization? @relation(fields: [organizationId], references: [id])
  accounts       Account[]
  sessions       Session[]
  allocations    Allocation[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
